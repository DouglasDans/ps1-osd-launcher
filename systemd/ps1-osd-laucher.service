[Unit]
Description=PS1 OSD Laucher
# Sobe o mais cedo possível: só espera filesystem + udev (necessários
# para /dev/dri e input). Sem DefaultDependencies o unit não esperaria
# shutdown.target — Conflicts/Before garantem parada ordenada.
# Depois do getty do tty1: ao subir ele reseta o VT (TTYReset) e desfaz o
# KD_GRAPHICS do hide_tty() — o console voltaria por cima da intro.
DefaultDependencies=no
After=local-fs.target systemd-udevd.service plymouth-start.service getty@tty1.service
Wants=local-fs.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=simple
User=douglasdans
WorkingDirectory=/home/douglasdans/ps1-osd-laucher
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_FBDEV=/dev/fb0
# O splash do Plymouth é DRM master: enquanto ele vive, o SDL descarta a
# placa ("kmsdrm not available"). Encerra mantendo a última imagem na tela;
# "+" roda como root, "-" ignora o erro se ele já tiver saído.
ExecStartPre=+-/usr/bin/plymouth quit --retain-splash
ExecStart=/home/douglasdans/ps1-osd-laucher/venv/bin/python3 /home/douglasdans/ps1-osd-laucher/launcher.py
# Se o DRM/ALSA ainda não existirem no boot antecipado, o SDL falha e a
# re-tentativa em 1s cobre a janela até o udev criar os devices.
SyslogIdentifier=ps1-launcher
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
